---
import '../styles/global.css';
import '@fontsource-variable/cormorant-garamond/wght.css';
import '@fontsource-variable/cormorant-garamond/wght-italic.css';
import '@fontsource-variable/source-sans-3/wght.css';
import '@fontsource-variable/source-sans-3/wght-italic.css';
import '@fontsource/dm-mono/400.css';

interface Props {
  title?: string;
  description?: string;
  lang?: 'sq' | 'en';
  sqPath?: string;
  enPath?: string;
  jsonLd?: string;
}

const {
  title = 'Stani i Hoxhës — Malet e Novosejës',
  description = 'Destinacion turistik sezonor në malet e Novosejës, Kukës. Hapur 22 maj — fund gushti.',
  lang = 'sq',
  sqPath = '/',
  enPath = '/en',
  jsonLd,
} = Astro.props;

const siteOrigin = Astro.site?.origin ?? Astro.url.origin;
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).href;
const ogImage = `${siteOrigin}/images/hero.webp`;
const ogLocale = lang === 'sq' ? 'sq_AL' : 'en_US';
const ogLocaleAlt = lang === 'sq' ? 'en_US' : 'sq_AL';
---
<!doctype html>
<html lang={lang} dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/assets/logo-stani.svg" />
    <link rel="alternate" hreflang="x-default" href={`${siteOrigin}${sqPath}`} />
    <link rel="alternate" hreflang="sq" href={`${siteOrigin}${sqPath}`} />
    <link rel="alternate" hreflang="en" href={`${siteOrigin}${enPath}`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Stani i Hoxhës" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
  </head>
  <body>
    <slot />
  </body>
</html>
