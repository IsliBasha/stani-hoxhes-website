---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lang?: 'sq' | 'en';
}

const {
  title = 'Stani i Hoxhës — Malet e Novosejës',
  description = 'Destinacion turistik sezonor në malet e Novosejës, Kukës. Hapur 22 maj — fund gushti.',
  lang = 'sq',
} = Astro.props;
---
<!doctype html>
<html lang={lang} dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/assets/logo-stani.svg" />
    <link rel="alternate" hreflang="sq" href="/" />
    <link rel="alternate" hreflang="en" href="/en" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <slot />
  </body>
</html>
