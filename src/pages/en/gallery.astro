---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/layout/Nav.astro';
import Footer from '../../components/layout/Footer.astro';
import { useTranslations } from '../../i18n/utils';
import 'glightbox/dist/css/glightbox.min.css';
import fs from 'node:fs';
import path from 'node:path';
import sharp from 'sharp';

const lang = 'en' as const;
const t = useTranslations(lang);
const tg = t.galleryPage;

interface PhotoEntry {
  src: string;
  kind: 'landscape' | 'portrait';
}

const fullDir = path.join(process.cwd(), 'public/images/gallery/full');
let photos: PhotoEntry[] = [];

try {
  const files = fs.readdirSync(fullDir)
    .filter(f => /\.(webp|jpg|jpeg|png)$/i.test(f))
    .sort();

  photos = await Promise.all(
    files.map(async (f): Promise<PhotoEntry> => {
      const meta = await sharp(path.join(fullDir, f)).metadata();
      const w = meta.width ?? 1;
      const h = meta.height ?? 1;
      return {
        src: `/images/gallery/full/${f}`,
        kind: w / h > 1.1 ? 'landscape' : 'portrait',
      };
    })
  );
} catch {
  photos = Array.from({ length: 8 }, (_, i): PhotoEntry => ({
    src: `/images/gallery/${String(i + 1).padStart(2, '0')}.webp`,
    kind: 'portrait',
  }));
}

const total = photos.length;
---

<Base
  lang={lang}
  title="Gallery — Stani i Hoxhës"
  description="Full photo gallery from Stani i Hoxhës and the Novoseja highlands, Kukës."
>
  <Nav t={t.nav} lang={lang} />

  <main>
    <header class="gp__header">
      <div class="gp__header-inner container">
        <a href="/en" class="gp__back eyebrow">{tg.back}</a>
        <div class="gp__title-row">
          <div class="gp__title-block">
            <p class="gp__eyebrow eyebrow">{tg.eyebrow}</p>
            <h1 class="gp__title">{tg.title}</h1>
          </div>
          <div class="gp__stat" aria-hidden="true">
            <span class="gp__stat-num">{total}</span>
            <span class="gp__stat-label eyebrow">{tg.photoLabel}</span>
          </div>
        </div>
        <p class="gp__subtitle">{tg.subtitle}</p>
      </div>
    </header>

    <div class="gp__grid" role="list" aria-label={`${total} ${tg.photoLabel}`}>
      {photos.map((photo, i) => (
        <a
          href={photo.src}
          class={`gp__item gp__item--${photo.kind} glightbox`}
          data-gallery="full"
          data-description={`${i + 1} / ${total}`}
          aria-label={`Photo ${i + 1}`}
          role="listitem"
        >
          <img
            src={photo.src}
            alt={`Photo ${i + 1} — Stani i Hoxhës`}
            class="gp__img"
            loading={i < 9 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : undefined}
          />
          <span class="gp__idx" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        </a>
      ))}
    </div>
  </main>

  <Footer t={t.footer} />
</Base>

<style>
  /* ─── Header ──────────────────────────────────────── */

  .gp__header {
    background: var(--green-deep);
    padding-top: clamp(6rem, 14vh, 9rem);
    padding-bottom: clamp(2.5rem, 5vh, 4rem);
    border-bottom: 1px solid oklch(62.1% 0.088 72 / 0.18);
  }

  .gp__header-inner {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .gp__back {
    align-self: flex-start;
    color: rgba(255 255 255 / 0.28);
    text-decoration: none;
    letter-spacing: 0.14em;
    transition: color var(--dur-fast);
  }
  .gp__back:hover { color: rgba(255 255 255 / 0.72); }

  .gp__title-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
  }

  .gp__title-block {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .gp__eyebrow {
    color: var(--gold);
    letter-spacing: 0.18em;
    display: block;
  }

  .gp__title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 300;
    letter-spacing: 0.04em;
    color: var(--paper);
    line-height: 1.1;
    margin: 0;
  }

  .gp__stat {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    flex-shrink: 0;
    gap: 2px;
  }

  .gp__stat-num {
    font-family: var(--font-display);
    font-size: clamp(3rem, 6vw, 5.5rem);
    font-weight: 300;
    line-height: 1;
    color: oklch(98.5% 0.004 85 / 0.17);
    letter-spacing: -0.02em;
  }

  .gp__stat-label {
    color: rgba(255 255 255 / 0.28);
    letter-spacing: 0.16em;
  }

  .gp__subtitle {
    font-size: 0.875rem;
    color: rgba(255 255 255 / 0.38);
    line-height: 1.75;
    max-width: 52ch;
    margin: 0;
  }

  /* ─── Grid ────────────────────────────────────────── */

  .gp__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: clamp(250px, 30vw, 480px);
    grid-auto-flow: dense;
    gap: 6px;
    padding: clamp(1.5rem, 3vw, 2.5rem) var(--section-x);
    background: var(--paper-2);
  }

  .gp__item {
    display: block;
    overflow: hidden;
    position: relative;
    cursor: zoom-in;
  }

  .gp__item--landscape {
    grid-column: span 2;
  }

  .gp__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition:
      opacity 0.35s ease,
      transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (hover: hover) {
    .gp__item:hover .gp__img {
      opacity: 0.86;
      transform: scale(1.03);
    }
    .gp__item:hover .gp__idx {
      opacity: 1;
    }
  }

  .gp__idx {
    position: absolute;
    bottom: 9px;
    left: 11px;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.2em;
    color: rgba(255 255 255 / 0.7);
    opacity: 0;
    transition: opacity 0.25s ease;
    pointer-events: none;
    user-select: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .gp__img { transition: opacity 0.2s ease; }
  }

  /* ─── Responsive ──────────────────────────────────── */

  @media (max-width: 768px) {
    .gp__grid {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: clamp(180px, 35vw, 300px);
      gap: 5px;
    }
    .gp__item--landscape { grid-column: span 2; }
  }

  @media (max-width: 640px) {
    .gp__grid { gap: 4px; padding-inline: clamp(0.75rem, 4vw, 1.5rem); }
    .gp__title-row { flex-direction: column; align-items: flex-start; gap: 10px; }
    .gp__stat { align-items: flex-start; flex-direction: row; align-items: baseline; gap: 10px; }
    .gp__stat-num { font-size: clamp(2rem, 7vw, 3rem); }
  }
</style>

<style is:global>
  .glightbox-clean .gcontainer { background: oklch(6% 0.012 140 / 0.97) !important; }
  .glightbox-clean .gslide-title {
    font-family: var(--font-mono) !important;
    font-size: 10px !important;
    letter-spacing: 0.16em !important;
    text-transform: uppercase !important;
    color: rgba(255 255 255 / 0.4) !important;
    font-weight: 400 !important;
    margin: 0 !important;
  }
  .glightbox-clean .gnext,
  .glightbox-clean .gprev {
    background: transparent !important;
    border: 1px solid rgba(255 255 255 / 0.16) !important;
    border-radius: 0 !important;
  }
  .glightbox-clean .gnext:hover,
  .glightbox-clean .gprev:hover { background: rgba(255 255 255 / 0.06) !important; }
  .glightbox-clean .gclose svg path { fill: rgba(255 255 255 / 0.55) !important; }
  .glightbox-clean .gclose:hover svg path { fill: rgba(255 255 255 / 1) !important; }
</style>

<script>
  import GLightbox from 'glightbox';
  GLightbox({ touchNavigation: true, loop: true, autoplayVideos: false });
</script>
