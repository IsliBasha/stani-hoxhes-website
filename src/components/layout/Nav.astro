---
import type { UI, Lang } from '../../i18n/ui';

interface Props {
  t: UI['nav'];
  lang: Lang;
}

const { t } = Astro.props;
---

<header class="nav" id="nav">
  <!-- Top utility bar -->
  <div class="nav__utility">
    <div class="nav__utility-inner container">
      <a href="tel:+355692404448" class="nav__util-item">+355 69 240 4448</a>
      <a href="mailto:staniihoxhes@gmail.com" class="nav__util-item">staniihoxhes@gmail.com</a>
      <a href={t.langSwitchUrl} class="nav__util-lang nav__util-lang--push" aria-label="Switch language">{t.langSwitch}</a>
    </div>
  </div>

  <!-- Desktop main bar -->
  <div class="nav__main container">
    <nav class="nav__links" aria-label="Site navigation left">
      {t.links.map((label, i) => (
        <a href={t.linkHrefs[i]} class="nav__link">{label}</a>
      ))}
    </nav>

    <a href="/" class="nav__wordmark" aria-label="Stani i Hoxhës home">
      {t.wordmark}
    </a>

    <nav class="nav__links nav__links--right" aria-label="Site navigation right">
      {t.right.map((label, i) => (
        <a
          href={t.rightHrefs[i]}
          class={`nav__link${(label === 'REZERVO' || label === 'RESERVE') ? ' nav__link--cta' : ''}`}
        >
          {label}
        </a>
      ))}
    </nav>
  </div>

  <!-- Mobile bar -->
  <div class="nav__mobile container">
    <button class="nav__toggle" aria-label="Open menu" aria-expanded="false" aria-controls="nav-mobile-menu">
      <span class="nav__burger" aria-hidden="true"></span>
    </button>
    <a href="/" class="nav__wordmark nav__wordmark--mobile">{t.wordmark}</a>
    <a href={t.langSwitchUrl} class="nav__util-lang">{t.langSwitch}</a>
  </div>

  <!-- Mobile dropdown -->
  <nav class="nav__mobile-menu" id="nav-mobile-menu" aria-hidden="true" aria-label="Mobile navigation">
    {[...t.links.map((l, i) => ({ label: l, href: t.linkHrefs[i] })),
       ...t.right.map((l, i) => ({ label: l, href: t.rightHrefs[i] }))].map(({ label, href }) => (
      <a href={href} class="nav__mobile-link">{label}</a>
    ))}
  </nav>
</header>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    z-index: 100;
    background: var(--paper);
    border-bottom: 1px solid var(--line);
    transition:
      transform 0.52s var(--ease-out-expo),
      opacity 0.38s var(--ease-out-expo),
      background var(--dur-norm) var(--ease-out-expo),
      border-color var(--dur-norm) var(--ease-out-expo);
  }

  /* Hidden above viewport — hero pages only, set via JS */
  .nav--hidden {
    transform: translateY(-100%);
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
  }

  .nav.nav--scrolled {
    background: var(--green-deep);
    border-color: transparent;
  }

  /* Utility bar */
  .nav__utility {
    background: var(--green-deep);
    border-bottom: 1px solid rgba(255 255 255 / 0.08);
    transition:
      background var(--dur-norm) var(--ease-out-expo),
      border-color var(--dur-norm) var(--ease-out-expo);
  }
  .nav--scrolled .nav__utility { background: var(--green-moss); border-color: rgba(255 255 255 / 0.08); }

  .nav__utility-inner {
    display: flex;
    align-items: center;
    gap: 24px;
    padding-block: 7px;
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    letter-spacing: 0.14em;
    color: rgba(255 255 255 / 0.55);
  }

  .nav__util-lang--push { margin-left: auto; }

  .nav__util-item,
  .nav__util-lang {
    text-decoration: none;
    text-transform: uppercase;
    transition: color var(--dur-fast);
  }
  .nav__util-item:hover, .nav__util-lang:hover { color: rgba(255 255 255 / 0.95); }

  /* Main bar */
  .nav__main {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding-block: 20px;
  }

  .nav__links { display: flex; gap: 28px; align-items: center; }
  .nav__links--right { justify-content: flex-end; }

  .nav__link {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink-2);
    transition: color var(--dur-fast);
  }
  .nav__link:hover { color: var(--ink); }

  .nav__wordmark {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 300;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--gold-deep);
    white-space: nowrap;
    transition: color var(--dur-fast);
  }
  .nav__wordmark:hover { color: var(--gold); }

  .nav__link--cta {
    color: var(--gold) !important;
    border-bottom: 1px solid var(--gold);
    padding-bottom: 2px;
  }
  .nav__link--cta:hover { color: var(--gold-deep) !important; border-color: var(--gold-deep); }

  .nav--scrolled .nav__link { color: rgba(255 255 255 / 0.65); }
  .nav--scrolled .nav__link:hover { color: var(--paper); }
  .nav--scrolled .nav__wordmark { color: var(--gold-light); }
  .nav--scrolled .nav__wordmark:hover { color: var(--paper); }
  .nav--scrolled .nav__link--cta { color: var(--gold-light) !important; border-color: var(--gold-light); }
  .nav--scrolled .nav__link--cta:hover { color: var(--paper) !important; border-color: var(--paper); }

  /* Mobile nav */
  .nav__mobile {
    display: none;
    align-items: center;
    justify-content: space-between;
    padding-block: 16px;
  }

  .nav__wordmark--mobile {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    letter-spacing: 0.2em;
    text-decoration: none;
    color: var(--ink);
    transition: color var(--dur-fast);
  }
  .nav--scrolled .nav__wordmark--mobile { color: var(--paper); }

  .nav__toggle {
    background: none;
    border: none;
    cursor: pointer;
    min-height: 44px;
    min-width: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .nav__burger {
    display: block;
    width: 22px;
    height: 1.5px;
    background: var(--ink);
    position: relative;
    transition: background var(--dur-norm);
  }
  .nav__burger::before,
  .nav__burger::after {
    content: '';
    position: absolute;
    left: 0;
    width: 22px;
    height: 1.5px;
    background: var(--ink);
    transition: top var(--dur-norm) var(--ease-out-expo),
                transform var(--dur-norm) var(--ease-out-expo);
  }
  .nav__burger::before { top: -6px; }
  .nav__burger::after  { top: 6px; }

  .nav--scrolled .nav__burger,
  .nav--scrolled .nav__burger::before,
  .nav--scrolled .nav__burger::after { background: var(--paper); }

  .nav__mobile-menu {
    display: none;
    flex-direction: column;
    background: var(--paper);
    border-top: 1px solid var(--line-2);
  }
  .nav__mobile-menu.is-open { display: flex; }

  .nav__mobile-link {
    padding: 14px var(--section-x);
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink-2);
    border-bottom: 1px solid var(--line-2);
    min-height: 44px;
    display: flex;
    align-items: center;
  }
  .nav__mobile-link:hover { color: var(--ink); }

  @media (max-width: 640px) {
    .nav__utility,
    .nav__main { display: none; }
    .nav__mobile { display: flex; }
  }
</style>

<script>
  const nav = document.getElementById('nav') as HTMLElement | null;
  const hero = document.querySelector('.hero') as HTMLElement | null;
  const toggle = document.querySelector('.nav__toggle') as HTMLButtonElement | null;
  const menu = document.getElementById('nav-mobile-menu') as HTMLElement | null;

  if (nav && hero) {
    nav.classList.add('nav--hidden');
    const io = new IntersectionObserver(
      ([entry]) => {
        nav.classList.toggle('nav--hidden', entry.isIntersecting);
        nav.classList.toggle('nav--scrolled', !entry.isIntersecting);
      },
      { threshold: 0, rootMargin: '-1px 0px 0px 0px' }
    );
    io.observe(hero);
  }

  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const open = menu.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      menu.setAttribute('aria-hidden', String(!open));
    });

    menu.querySelectorAll<HTMLAnchorElement>('.nav__mobile-link').forEach((link) => {
      link.addEventListener('click', () => {
        menu.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Open menu');
        menu.setAttribute('aria-hidden', 'true');
      });
    });
  }
</script>
