---
import type { UI } from '../../i18n/ui';
import 'glightbox/dist/css/glightbox.min.css';

interface Props {
  t: UI['gallery'];
}

const { t } = Astro.props;

const galleryImages = [
  { src: '/images/gallery/01.webp', w: 1200, h: 801  },
  { src: '/images/gallery/02.webp', w: 1200, h: 1800 },
  { src: '/images/gallery/03.webp', w: 801,  h: 1200 },
  { src: '/images/gallery/04.webp', w: 800,  h: 1200 },
  { src: '/images/gallery/05.webp', w: 801,  h: 1200 },
  { src: '/images/gallery/06.webp', w: 1200, h: 800  },
  { src: '/images/gallery/07.webp', w: 1200, h: 800  },
  { src: '/images/gallery/08.webp', w: 1200, h: 800  },
];
---

<section class="gallery section" id="galeria" aria-labelledby="gallery-title">
  <div class="container">
    <div class="gallery__head section-head">
      <span class="section-head__num">{t.num}</span>
      <p class="section-head__label">{t.eyebrow}</p>
      <h2 class="section-head__title" id="gallery-title">{t.title}</h2>
      <p class="section-head__sub">{t.subtitle}</p>
    </div>

    <div class="gallery__grid" role="list" aria-label="Photo gallery">
      {t.labels.map((label, i) => (
        <a
          href={galleryImages[i].src}
          class={`gallery__item gallery__item--${i + 1} glightbox`}
          data-gallery="homepage"
          data-title={label}
          role="listitem"
          aria-label={`Open: ${label}`}
        >
          <img
            src={galleryImages[i].src}
            alt={label}
            class="gallery__img"
            width={galleryImages[i].w}
            height={galleryImages[i].h}
            loading={i === 0 ? 'eager' : 'lazy'}
          />
        </a>
      ))}
    </div>

    <div class="gallery__footer">
      <a href={t.href} class="gallery__cta eyebrow">{t.viewAll}</a>
    </div>
  </div>
</section>

<style>
  .gallery { background: var(--paper-2); }

  .gallery__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .gallery__head .section-head__sub {
    text-align: center;
    max-width: 36ch;
    margin-inline: auto;
  }

  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 200px;
    gap: 10px;
    margin-top: 48px;
  }

  .gallery__item {
    overflow: hidden;
    display: block;
  }

  .gallery__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .gallery__item:hover .gallery__img { transform: scale(1.04); }

  .gallery__item--1 { grid-column: span 2; grid-row: span 2; }
  .gallery__item--6 { grid-column: span 2; }

  .gallery__footer {
    margin-top: 40px;
    display: flex;
    justify-content: center;
  }

  .gallery__cta {
    display: inline-block;
    padding: 13px 32px;
    border: 1px solid var(--ink);
    color: var(--ink);
    text-decoration: none;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: var(--text-eyebrow);
    transition: background var(--dur-fast), color var(--dur-fast);
  }
  .gallery__cta:hover {
    background: var(--ink);
    color: var(--paper);
  }

  @media (max-width: 640px) {
    .gallery__grid {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 140px;
    }
    .gallery__item--1 { grid-column: span 2; grid-row: span 1; }
    .gallery__item--6 { grid-column: span 2; }
  }
</style>

<style is:global>
  .glightbox-clean .gcontainer { background: oklch(6% 0.012 140 / 0.97) !important; }
  .glightbox-clean .gslide-title {
    font-family: var(--font-mono) !important;
    font-size: 10px !important;
    letter-spacing: 0.16em !important;
    text-transform: uppercase !important;
    color: rgba(255 255 255 / 0.45) !important;
    font-weight: 400 !important;
    margin: 0 !important;
  }
  .glightbox-clean .gnext,
  .glightbox-clean .gprev {
    background: transparent !important;
    border: 1px solid rgba(255 255 255 / 0.18) !important;
    border-radius: 0 !important;
  }
  .glightbox-clean .gnext:hover,
  .glightbox-clean .gprev:hover { background: rgba(255 255 255 / 0.07) !important; }
  .glightbox-clean .gclose {
    width: 44px !important;
    height: 44px !important;
    top: 10px !important;
    right: 10px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
  }
  .glightbox-clean .gclose svg path { fill: rgba(255 255 255 / 0.6) !important; }
  .glightbox-clean .gclose:hover svg path { fill: rgba(255 255 255 / 1) !important; }
</style>

<script>
  import GLightbox from 'glightbox';
  GLightbox({ touchNavigation: true, loop: true, autoplayVideos: false, closeEffect: 'none', openEffect: 'none' });
</script>
