---
import type { UI } from '../../i18n/ui';

interface Props {
  t: UI['gallery'];
}

const { t } = Astro.props;

const galleryImages = [
  { src: '/images/gallery/01.webp', w: 1200, h: 800 },
  { src: '/images/gallery/02.webp', w: 800,  h: 1200 },
  { src: '/images/gallery/03.webp', w: 800,  h: 1200 },
  { src: '/images/gallery/04.webp', w: 800,  h: 1200 },
  { src: '/images/gallery/05.webp', w: 800,  h: 1200 },
  { src: '/images/gallery/06.webp', w: 1200, h: 800  },
  { src: '/images/gallery/07.webp', w: 1200, h: 800  },
  { src: '/images/gallery/08.webp', w: 800,  h: 1200 },
];
---

<section class="gallery section" id="galeria" aria-labelledby="gallery-title">
  <div class="container">
    <div class="gallery__head section-head" style="align-items: center; text-align: center;">
      <span class="section-head__num">{t.num}</span>
      <p class="section-head__label">{t.eyebrow}</p>
      <h2 class="section-head__title" id="gallery-title">{t.title}</h2>
      <p class="section-head__sub" style="text-align: center; max-width: 36ch; margin-inline: auto;">{t.subtitle}</p>
    </div>

    <div class="gallery__grid" role="list" aria-label="Photo gallery">
      {t.labels.map((label, i) => (
        <div class={`gallery__item gallery__item--${i + 1}`} role="listitem">
          <img
            src={galleryImages[i].src}
            alt={label}
            class="gallery__img"
            width={galleryImages[i].w}
            height={galleryImages[i].h}
            loading={i === 0 ? 'eager' : 'lazy'}
          />
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .gallery {
    background: var(--paper-2);
  }

  .gallery__head {
    display: flex;
    flex-direction: column;
  }

  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 200px;
    gap: 10px;
    margin-top: 48px;
  }

  .gallery__item { overflow: hidden; }

  .gallery__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .gallery__item:hover .gallery__img { transform: scale(1.04); }

  /* Mosaic layout matching dir-a.jsx */
  .gallery__item--1 { grid-column: span 2; grid-row: span 2; }
  .gallery__item--6 { grid-column: span 2; }

  @media (max-width: 640px) {
    .gallery__grid {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 140px;
    }

    .gallery__item--1 {
      grid-column: span 2;
      grid-row: span 1;
    }

    .gallery__item--6 {
      grid-column: span 2;
    }
  }
</style>
