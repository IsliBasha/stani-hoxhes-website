---
import type { UI } from '../../i18n/ui';

interface Props {
  t: UI['why'];
}

const { t } = Astro.props;
---

<section class="why" aria-labelledby="why-title">
  <div class="why__inner container">
    <div class="why__head section-head section-head--light">
      <p class="section-head__label">{t.eyebrow}</p>
      <h2 class="section-head__title" id="why-title">{t.title}</h2>
      <p class="section-head__sub">{t.subtitle}</p>
    </div>

    <dl class="why__pillars">
      {t.pillars.map((pillar) => (
        <div class="why__pillar">
          <dt class="why__pillar-name">{pillar.sq}</dt>
          <dd class="why__pillar-en">{pillar.en}</dd>
          <dd class="why__pillar-desc">{pillar.desc}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .why {
    background: var(--green);
    color: var(--paper);
    padding-block: var(--section-y);
  }

  .why__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .why__head {
    max-width: 52rem;
  }

  .why__head .section-head__sub {
    margin-inline: auto;
  }

  .why__head .section-head__title {
    font-size: clamp(1.625rem, 0.5rem + 3vw, 2.5rem);
    line-height: 1.2;
  }

  .why__pillars {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    margin-top: clamp(2.5rem, 1.5rem + 3vw, 3.5rem);
    width: 100%;
    max-width: 56rem;
  }

  .why__pillar {
    border-top: 1px solid rgba(255 255 255 / 0.2);
    padding-top: 20px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .why__pillar-name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 400;
    color: var(--paper);
  }

  .why__pillar-en {
    font-size: var(--text-xs);
    font-style: italic;
    color: rgba(255 255 255 / 0.45);
    letter-spacing: 0.06em;
  }

  .why__pillar-desc {
    font-size: var(--text-sm);
    color: rgba(255 255 255 / 0.7);
    margin-top: 8px;
    line-height: 1.5;
  }

  @media (max-width: 640px) {
    .why__pillars {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
</style>
