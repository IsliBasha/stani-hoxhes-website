---
import type { UI } from '../../i18n/ui';

interface Props {
  t: UI['location'];
}

const { t } = Astro.props;

const MAPS_URL = 'https://www.google.com/maps?q=41.9714504,20.5791311';
const COORDS = '41°58\'17″N · 20°34\'45″E';
---

<section class="location section" id="ndodhemi" aria-labelledby="location-title">
  <div class="location__inner container">

    <div class="location__text">
      <div class="section-head">
        <span class="section-head__num">{t.num}</span>
        <p class="section-head__label">{t.eyebrow}</p>
        <h2 class="section-head__title" id="location-title">{t.title}</h2>
        <p class="section-head__sub">{t.subtitle}</p>
      </div>
    </div>

    <div class="location__panel">
      <p class="location__coords" aria-label="GPS coordinates">{COORDS}</p>

      <dl class="location__distances">
        {t.distances.map((d) => (
          <div class="location__row">
            <dt class="location__place">{d.place}</dt>
            <dd class="location__dist eyebrow">{d.dist}</dd>
          </div>
        ))}
      </dl>

      <a
        href={MAPS_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="location__cta eyebrow"
      >
        {t.openInMaps}
      </a>
    </div>

  </div>
</section>

<style>
  .location {
    background: var(--paper-2);
  }

  .location__inner {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 60px;
    align-items: start;
  }

  /* ── Right panel ─────────────────────────────── */

  .location__panel {
    display: flex;
    flex-direction: column;
  }

  .location__coords {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold-deep);
    margin-bottom: 28px;
  }

  .location__distances {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--gold);
  }

  .location__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding-block: 18px;
    border-bottom: 1px solid var(--line);
  }

  .location__place {
    font-size: var(--text-base);
    color: var(--ink);
    font-weight: 400;
  }

  .location__dist {
    color: var(--ink-3);
    letter-spacing: 0.12em;
    flex-shrink: 0;
  }

  .location__cta {
    display: block;
    margin-top: 24px;
    padding: 14px 20px;
    border: 1px solid var(--ink);
    text-align: center;
    text-decoration: none;
    color: var(--ink);
    font-size: var(--text-eyebrow);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: background var(--dur-fast), color var(--dur-fast);
  }

  .location__cta:hover {
    background: var(--ink);
    color: var(--paper);
  }

  @media (max-width: 640px) {
    .location__inner {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }
</style>
