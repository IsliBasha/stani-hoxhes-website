---
import type { UI } from '../../i18n/ui';

interface Props {
  t: UI['hero'];
}

const { t } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">

  <video
    class="hero__video"
    autoplay
    muted
    loop
    playsinline
    poster="/images/hero.webp"
    aria-hidden="true"
  >
    <source src="/videos/hero.mp4" type="video/mp4" />
  </video>

  <div class="hero__overlay" aria-hidden="true"></div>

  <div class="hero__inner">

    <div class="hero__badge" aria-label="Season dates">
      {t.badge}
    </div>

    <div class="hero__text">
      <p class="hero__eyebrow">{t.eyebrow}</p>
      <h1 class="hero__title" id="hero-title">{t.title}</h1>
      <p class="hero__tagline">{t.tagline}</p>
    </div>

    <div class="hero__scroll" aria-hidden="true">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M4 7l6 6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>

  </div>

</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    overflow: hidden;
  }

  /* ── Video layer ── */
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  /* ── Bottom gradient: darkens lower third for depth ── */
  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(
        to top,
        oklch(17.2% 0.041 145 / 0.97) 0%,
        oklch(17.2% 0.041 145 / 0.72) 28%,
        oklch(17.2% 0.041 145 / 0.28) 52%,
        oklch(17.2% 0.041 145 / 0.06) 68%,
        transparent 80%
      );
  }

  /* ── Content wrapper ── */
  .hero__inner {
    position: relative;
    z-index: 2;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-inline: var(--section-x);
    padding-top: clamp(5rem, 12vh, 8rem);
    padding-bottom: clamp(4.5rem, 9vh, 6.5rem);
    min-height: inherit;
    box-sizing: border-box;
  }

  /* ── Season badge ── */
  .hero__badge {
    position: absolute;
    top: clamp(4rem, 9vh, 6.5rem);
    right: var(--section-x);
    border: 1px solid var(--gold);
    color: var(--gold-light);
    padding: 6px 14px;
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    white-space: nowrap;
    animation: hero-fade 0.7s var(--ease-out-expo) 0.65s both;
  }

  /* ── Text block ── */
  .hero__text {
    text-align: center;
    max-width: 56ch;
  }

  .hero__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255 255 255 / 0.55);
    text-shadow: 0 1px 10px oklch(8% 0.02 145 / 0.7);
    animation: hero-up 0.9s var(--ease-out-expo) 0.1s both;
  }

  .hero__eyebrow::before {
    content: '';
    display: block;
    width: 2rem;
    height: 1px;
    background: var(--gold);
    opacity: 0.7;
    margin: 0 auto 14px;
  }

  .hero__title {
    font-family: var(--font-display);
    font-size: clamp(3.75rem, 2rem + 7vw, 8.5rem);
    font-weight: 300;
    letter-spacing: -0.01em;
    line-height: 1.03;
    color: var(--gold-light);
    margin-top: 10px;
    animation: hero-up 0.9s var(--ease-out-expo) 0.22s both;
  }

  .hero__tagline {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 0.4rem + 2vw, 1.45rem);
    font-weight: 300;
    font-style: italic;
    color: rgba(255 255 255 / 0.82);
    margin-top: 12px;
    line-height: 1.45;
    text-shadow: 0 2px 18px oklch(8% 0.02 145 / 0.65);
    animation: hero-up 0.9s var(--ease-out-expo) 0.34s both;
  }

  /* ── Scroll chevron ── */
  .hero__scroll {
    position: absolute;
    bottom: 1.75rem;
    left: 50%;
    transform: translateX(-50%);
    color: rgba(255 255 255 / 0.42);
    display: flex;
    align-items: center;
    justify-content: center;
    animation:
      hero-fade 1s var(--ease-out-expo) 1.1s both,
      chevron-pulse 2.6s ease-in-out 2.3s infinite;
  }

  /* ── Keyframes ── */
  @keyframes hero-up {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes hero-fade {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  @keyframes chevron-pulse {
    0%, 100% { transform: translateX(-50%) translateY(0);   opacity: 0.42; }
    50%       { transform: translateX(-50%) translateY(7px); opacity: 0.9; }
  }

  /* ── Reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    .hero__eyebrow,
    .hero__title,
    .hero__tagline,
    .hero__widget-wrap,
    .hero__badge {
      animation: none;
    }
    .hero__scroll {
      animation: none;
      opacity: 0.42;
      transform: translateX(-50%);
    }
  }

  /* ── Mobile ── */
  @media (max-width: 640px) {
    .hero__badge {
      font-size: 7.5px;
      padding: 5px 10px;
      top: clamp(3.5rem, 8vh, 5rem);
    }

    .hero__title {
      font-size: clamp(2.75rem, 11vw, 4rem);
    }

    .hero__scroll {
      bottom: 1.25rem;
    }
  }
</style>

