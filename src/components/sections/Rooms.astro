---
import { getCollection } from 'astro:content';
import type { UI, Lang } from '../../i18n/ui';

interface Props {
  t: UI['rooms'];
  lang: Lang;
}

const { t, lang } = Astro.props;

const allRooms = await getCollection('rooms');
const rooms = allRooms.sort((a, b) => a.data.order - b.data.order);

const buildingLabels = t.buildingLabels as Record<string, string>;
const amenityLabels  = t.amenityLabels  as Record<string, string>;

function getRoomDetailUrl(slug: string, l: Lang): string {
  return l === 'en' ? `/en/rooms/${slug}` : `/dhomat/${slug}`;
}
---

<section class="rooms section" id="qendrimi" aria-labelledby="rooms-title">
  <div class="container">
    <div class="rooms__head">
      <div class="section-head">
        <span class="section-head__num">{t.num}</span>
        <p class="section-head__label">{t.eyebrow}</p>
        <h2 class="section-head__title" id="rooms-title">{t.title}</h2>
        <p class="section-head__sub">{t.subtitle}</p>
      </div>
      <a href="#kontakt" class="rooms__view-all eyebrow">{t.viewAll}</a>
    </div>

    <div class="rooms__grid" role="list">
      {rooms.map((room) => {
        const name    = lang === 'en' ? room.data.name_en : room.data.name_sq;
        const nameAlt = lang === 'en' ? room.data.name_sq : room.data.name_en;
        const view    = lang === 'en' ? room.data.view_en : room.data.view_sq;
        const bldg    = buildingLabels[room.data.building] ?? room.data.building;
        const detailUrl = getRoomDetailUrl(room.slug, lang);

        return (
          <article class="room-card" role="listitem">
            <div class="room-card__image">
              <div class="img-ph" aria-hidden="true">
                <div class="img-ph__diamond"></div>
                <span>{name}</span>
              </div>
            </div>

            <div class="room-card__body">
              <div class="room-card__meta">
                <span class="eyebrow">{bldg.toUpperCase()} · {room.data.count} {t.total}</span>
                <span class="eyebrow">{room.data.price_from_eur !== null ? `${t.from} €${room.data.price_from_eur}` : '—'}</span>
              </div>

              <h3 class="room-card__name">{name}</h3>
              <p class="room-card__name-alt">{nameAlt}</p>

              {room.data.price_from_eur === null && (
                <a href="#kontakt" class="room-card__price-cta eyebrow">
                  {t.contactForPrices}
                </a>
              )}

              <ul class="room-card__chips" role="list">
                <li class="chip">{room.data.max_guests} {t.guests}</li>
                {room.data.size_sqm !== null && (
                  <li class="chip">{room.data.size_sqm} {t.sqm}</li>
                )}
                <li class="chip">{view}</li>
                {room.data.amenities.map((key) => (
                  <li class="chip">{amenityLabels[key] ?? key}</li>
                ))}
              </ul>

              <a href={detailUrl} class="room-card__cta eyebrow">{t.cta}</a>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  .rooms { background: var(--paper); }

  .rooms__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
  }

  .rooms__view-all {
    text-decoration: none;
    color: var(--ink-3);
    letter-spacing: 0.14em;
    white-space: nowrap;
    flex-shrink: 0;
    transition: color var(--dur-fast);
  }
  .rooms__view-all:hover { color: var(--gold); }

  .rooms__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 48px;
  }

  .room-card {
    border: 1px solid var(--line);
    display: flex;
    flex-direction: column;
  }

  .room-card__image {
    border-bottom: 1px solid var(--line);
  }

  .room-card__body {
    padding: 20px 22px 26px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .room-card__meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
    color: var(--ink-3);
  }

  .room-card__name {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 400;
    color: var(--ink);
    margin-top: 10px;
    line-height: 1.2;
  }

  .room-card__name-alt {
    font-size: var(--text-xs);
    font-style: italic;
    color: var(--ink-3);
    margin-top: 3px;
  }

  .room-card__price-cta {
    margin-top: 10px;
    color: var(--gold);
    text-decoration: none;
    font-size: var(--text-eyebrow);
    letter-spacing: 0.14em;
    transition: color var(--dur-fast);
  }
  .room-card__price-cta:hover { color: var(--gold-deep); }

  .room-card__chips {
    list-style: none;
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-top: 16px;
  }

  .room-card__cta {
    display: block;
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid var(--line-2);
    color: var(--ink);
    text-decoration: none;
    letter-spacing: 0.12em;
    transition: color var(--dur-fast);
  }
  .room-card__cta:hover { color: var(--gold); }

  @media (max-width: 640px) {
    .rooms__head { flex-direction: column; align-items: flex-start; }
    .rooms__grid { grid-template-columns: 1fr; gap: 28px; }
  }
</style>
