---
import type { UI } from '../../i18n/ui';

interface Props {
  t: UI['experiences'];
}

const { t } = Astro.props;
---

<section class="exp section" id="eksperienca" aria-labelledby="exp-title">
  <div class="container">
    <div class="section-head">
      <span class="section-head__num">{t.num}</span>
      <p class="section-head__label">{t.eyebrow}</p>
      <h2 class="section-head__title" id="exp-title">{t.title}</h2>
      <p class="section-head__sub">{t.subtitle}</p>
    </div>

    <ul class="exp__grid" role="list">
      {t.items.map((item) => (
        <li class="exp__item">
          <div class="exp__icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
              <circle cx="9" cy="9" r="8" stroke="currentColor" stroke-width="1"/>
            </svg>
          </div>
          <h3 class="exp__name">{item.sq}</h3>
          <p class="exp__name-en">{item.en}</p>
          <p class="exp__desc">{item.desc}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .exp {
    background: var(--paper);
    border-top: 1px solid var(--line);
  }

  .exp__grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 44px;
    margin-top: 48px;
  }

  .exp__item {
    display: flex;
    flex-direction: column;
  }

  .exp__icon {
    color: var(--gold);
    margin-bottom: 12px;
    width: 18px;
    height: 18px;
  }

  .exp__name {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 500;
    color: var(--ink);
    line-height: 1.3;
  }

  .exp__name-en {
    font-size: var(--text-xs);
    font-style: italic;
    color: var(--ink-3);
    letter-spacing: 0.04em;
    margin-top: 2px;
  }

  .exp__desc {
    font-size: var(--text-sm);
    color: var(--ink-2);
    margin-top: 10px;
    line-height: 1.6;
  }

  @media (max-width: 640px) {
    .exp__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 28px;
    }
  }
</style>
