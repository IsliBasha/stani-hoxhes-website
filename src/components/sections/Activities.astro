---
import type { UI, Lang } from '../../i18n/ui';

interface Props {
  t: UI['activities'];
  lang: Lang;
}

const { t, lang } = Astro.props;

const localizedPins = t.pins.map((p) => ({
  lat: p.lat,
  lng: p.lng,
  type: p.type,
  name: lang === 'en' ? p.en : p.sq,
}));
---

<section class="activities section" id="aktivitetet" aria-labelledby="activities-title">
  <div class="container">
    <div class="activities__inner">

      <div class="activities__text">
        <p class="section-head__label">{t.eyebrow}</p>
        <h2 class="activities__title" id="activities-title">{t.title}</h2>
        <p class="activities__sub">{t.subtitle}</p>

        <ul class="activities__legend" role="list">
          {t.legend.map((item) => (
            <li class="activities__legend-row">
              <span class={`activities__dot activities__dot--${item.type}`} aria-hidden="true"></span>
              <span class="activities__legend-label eyebrow">{item.label}</span>
            </li>
          ))}
        </ul>
      </div>

      <div
        class="activities__map"
        id="activities-map"
        data-pins={JSON.stringify(localizedPins)}
        aria-label={lang === 'en' ? 'Interactive map of nearby activities' : 'Harta ndërvepruese e aktiviteteve'}
      ></div>

    </div>
  </div>
</section>

<script>
  import 'leaflet/dist/leaflet.css';

  type Pin = { lat: number; lng: number; type: string; name: string };

  const container = document.getElementById('activities-map') as HTMLElement | null;
  if (container) {
    const observer = new IntersectionObserver(
      async (entries) => {
        if (!entries[0].isIntersecting) return;
        observer.disconnect();

        const { default: L } = await import('leaflet');
        const pins: Pin[] = JSON.parse(container.dataset.pins ?? '[]');

        const map = L.map(container, {
          zoomControl: true,
          scrollWheelZoom: false,
          attributionControl: true,
          minZoom: 11,
          maxZoom: 17,
        });

        L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
          attribution:
            'Tiles &copy; Esri &mdash; Source: Esri, USDA, USGS, AEX, GeoEye, Getmapping, Aerogrid, IGN, IGP, UPR-EGS, and the GIS User Community',
          maxZoom: 19,
        }).addTo(map);

        const hotelIcon = L.divIcon({
          html: `<svg width="30" height="30" viewBox="0 0 30 30" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="15" cy="15" r="14" fill="white" fill-opacity="0.95" stroke="oklch(52.3% 0.096 72)" stroke-width="1.5"/>
            <rect x="8" y="8" width="14" height="14" fill="oklch(52.3% 0.096 72)" transform="rotate(45 15 15)"/>
          </svg>`,
          className: 'map-icon',
          iconSize: [30, 30],
          iconAnchor: [15, 15],
          popupAnchor: [0, -18],
        });

        const natureIcon = L.divIcon({
          html: `<svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="10" cy="10" r="9" fill="white" fill-opacity="0.95" stroke="oklch(30% 0.07 145)" stroke-width="1.5"/>
            <circle cx="10" cy="10" r="5" fill="oklch(30% 0.07 145)"/>
          </svg>`,
          className: 'map-icon',
          iconSize: [20, 20],
          iconAnchor: [10, 10],
          popupAnchor: [0, -12],
        });

        const panoramaIcon = L.divIcon({
          html: `<svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="10" cy="10" r="9" fill="white" fill-opacity="0.95" stroke="oklch(58% 0.10 72)" stroke-width="1.5"/>
            <circle cx="10" cy="10" r="5" fill="oklch(58% 0.10 72)"/>
          </svg>`,
          className: 'map-icon',
          iconSize: [20, 20],
          iconAnchor: [10, 10],
          popupAnchor: [0, -12],
        });

        const villageIcon = L.divIcon({
          html: `<svg width="22" height="20" viewBox="0 0 22 20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <polygon points="11,2 20.5,18.5 1.5,18.5" fill="white" fill-opacity="0.95" stroke="oklch(50% 0.07 42)" stroke-width="1.5"/>
            <polygon points="11,6.5 17.5,16.5 4.5,16.5" fill="oklch(50% 0.07 42)"/>
          </svg>`,
          className: 'map-icon',
          iconSize: [22, 20],
          iconAnchor: [11, 10],
          popupAnchor: [0, -12],
        });

        pins.forEach((pin) => {
          let icon = natureIcon;
          if (pin.type === 'hotel') icon = hotelIcon;
          else if (pin.type === 'panorama') icon = panoramaIcon;
          else if (pin.type === 'village') icon = villageIcon;
          L.marker([pin.lat, pin.lng], { icon })
            .addTo(map)
            .bindPopup(`<span class="map-popup__label">${pin.name}</span>`, {
              className: 'map-popup',
              closeButton: false,
              maxWidth: 200,
            });
        });

        if (pins.length > 0) {
          const bounds = L.latLngBounds(pins.map((p) => [p.lat, p.lng] as [number, number]));
          map.fitBounds(bounds, { padding: [52, 52] });
        }
      },
      { rootMargin: '200px' }
    );
    observer.observe(container);
  }
</script>

<style>
  .activities {
    background: var(--paper);
    isolation: isolate;
  }

  .activities__inner {
    display: grid;
    grid-template-columns: 1fr 1.7fr;
    gap: 60px;
    align-items: start;
  }

  .activities__title {
    font-family: var(--font-display);
    font-size: var(--text-h1);
    font-weight: 300;
    color: var(--ink);
    margin-top: 10px;
    line-height: 1.1;
  }

  .activities__sub {
    margin-top: 10px;
    font-size: var(--text-sm);
    font-style: italic;
    color: var(--ink-3);
    line-height: 1.65;
    max-width: 34ch;
  }

  .activities__legend {
    list-style: none;
    margin-top: 36px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .activities__legend-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .activities__dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .activities__dot--hotel {
    background: var(--gold-deep);
    border-radius: 0;
    transform: rotate(45deg);
  }

  .activities__dot--nature   { background: var(--green); }
  .activities__dot--panorama { background: var(--gold); }
  .activities__dot--village  {
    background: oklch(50% 0.07 42);
    border-radius: 0;
    clip-path: polygon(50% 0%, 0% 100%, 100% 100%);
  }

  .activities__legend-label {
    color: var(--ink-3);
    letter-spacing: 0.14em;
  }

  .activities__map {
    height: 460px;
    border: 1px solid var(--line);
  }

  /* Leaflet overrides */
  :global(.map-icon) {
    background: transparent !important;
    border: none !important;
    filter: drop-shadow(0 1px 4px oklch(0% 0 0 / 0.55));
  }

  :global(.map-popup .leaflet-popup-content-wrapper) {
    border-radius: 0;
    box-shadow: 0 4px 16px oklch(15.2% 0.006 260 / 0.12);
    padding: 0;
    border: 1px solid var(--line);
  }

  :global(.map-popup .leaflet-popup-tip-container) {
    display: none;
  }

  :global(.map-popup .leaflet-popup-content) {
    margin: 10px 14px;
  }

  :global(.map-popup__label) {
    font-family: 'DM Mono', ui-monospace, monospace;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: oklch(15.2% 0.006 260);
    white-space: nowrap;
  }

  :global(.leaflet-attribution-flag) {
    display: none !important;
  }

  @media (max-width: 640px) {
    .activities__inner {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .activities__map {
      height: 300px;
    }
  }
</style>
